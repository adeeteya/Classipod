import "../../Fastfile"

def next_play_version_code
  require 'supply'
  package_name = ENV['APP_PACKAGE_NAME']
  UI.user_error!('APP_PACKAGE_NAME is required') if package_name.to_s.strip.empty?
  client = Supply::Client.make_from_config(
    params: { json_key: google_service_account_json_path, timeout: 300 }
  )
  begin
    client.begin_edit(package_name: package_name)
    # Fastlane's track action misses uploads not assigned to a track.
    codes = client.apks_version_codes + client.aab_version_codes
    client.tracks.each do |track|
      Array(track.releases).each do |release|
        codes.concat(Array(release.version_codes))
      end
    end
    code = (codes.map { |value| Integer(value.to_s, 10) }.max || 0) + 1
    UI.user_error!('Google Play version code limit reached') if code > 2_100_000_000
    code
  ensure
    client.abort_current_edit if client.current_edit
  end
end

default_platform(:android)

platform :android do

  desc "Select one Google Play build number for the APK and AAB"
  lane :prepare_build_number do
    code = next_play_version_code
    ENV['ANDROID_BUILD_NUMBER'] = code.to_s
    if ENV['GITHUB_ENV']
      File.open(ENV['GITHUB_ENV'], 'a') { |file| file.puts("ANDROID_BUILD_NUMBER=#{code}") }
    end
    UI.message("Using Google Play version code #{code} for this release")
  end

  # Build flutter Android app
  lane :build do |options|

    # Verify 'firebase_app_distribution_service_account.json' file exists
    unless File.exist?(google_service_account_json_path)
      UI.user_error!("google_service_account.json file not found. Please add it to the root of the flutter project. See https://docs.fastlane.tools/actions/supply/")
    end

    # Verify version number is correct
    if !is_ci && (!options[:version_number])
      version_number = get_version_from_pubspec()
      continue = UI.confirm("Deploying version #{version_number} (from pubspec.yaml) to Play Store. Continue?")

      unless continue
        UI.user_error!("Aborted")
      end
    end

    build_flutter_app(
      type: options[:type] || "appbundle",
      no_codesign: options[:no_codesign],
      config_only: options[:config_only],
      build_number: options[:build_number] || ENV['ANDROID_BUILD_NUMBER'] || next_play_version_code,
      version_number: options[:version_number],
      store: "playstore"
    )
  end

  # Release to Play Store using Fastlane Supply (https://docs.fastlane.tools/actions/supply/)
  desc "Release to Play Store"
  lane :release_play_store do |options|
    begin
      build(
        no_codesign: options[:no_codesign],
        config_only: options[:config_only],
        build_number: options[:build_number],
        version_number: options[:version_number]
      )

      symbolsFilePath = File.join(
        Dir.pwd,
        "..",
        "..",
        "native-debug-symbols.zip"
      )

      symbolsFolderPath = File.join(
        Dir.pwd,
        "..",
        "..",
        "build",
        "app",
        "intermediates",
        "merged_native_libs",
        "productionRelease",
        "mergeProductionReleaseNativeLibs",
        "out",
        "lib"
      )

      system("cd #{symbolsFolderPath} && zip -r #{symbolsFilePath} .")

      supply(
        track: 'internal',
        # Uncomment this if getting error "Only releases with status draft may be created on draft app."
        # release_status: 'draft',
        aab: "../build/app/outputs/bundle/productionRelease/app-production-release.aab",
        mapping_paths: [symbolsFilePath, "../build/app/outputs/mapping/productionRelease/mapping.txt"],
        metadata_path: File.expand_path("../../fastlane/metadata/android", __dir__),
        json_key: google_service_account_json_path,
        skip_upload_apk: true, # Upload the aab instead of apk
        skip_upload_metadata: false,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        timeout: 600
      )
    end
  end

  desc "Build Apk"
  lane :build_apk do |options|
    begin
      build(
        type: 'apk',
        no_codesign: options[:no_codesign],
        config_only: options[:config_only],
        build_number: options[:build_number],
        version_number: options[:version_number]
      )

      File.rename("#{root_path}/build/app/outputs/flutter-apk/app-production-release.apk", "#{root_path}/build/app/outputs/flutter-apk/Classipod-Android.apk")

      # set_github_release(
      #   repository_name: "adeeteya/Classipod",
      #   api_token: ENV["GH_TOKEN"],
      #   name: options[:version_number],
      #   tag_name: options[:version_number],
      #   is_generate_release_notes: true,
      #   commitish: "master",
      #   upload_assets: ["#{root_path}/build/app/outputs/flutter-apk/Classipod-Android.apk"]
      # )
    end
  end

  # Release to Play Store using Firebase App Distribution (https://docs.fastlane.tools/actions/firebase_app_distribution/)
  desc "Release to Play Store using Firebase App Distribution"
  lane :release_play_store_using_firebase do |options|
    begin
      build(
        type: 'apk',
        no_codesign: options[:no_codesign],
        config_only: options[:config_only],
        build_number: options[:build_number],
        version_number: options[:version_number]
      )

      firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID"],
        android_artifact_path: "#{root_path}/build/app/outputs/flutter-apk/app-production-release.apk",
        service_credentials_file: google_service_account_json_path,
        # Use the following to enable debug mode
        debug: true
      )
    end
  end
end
